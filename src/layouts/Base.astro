---
import { getSiteSettings } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import FloatingContact from "../components/footer/FloatingContact.astro";
import { siteConfig } from "../data/site";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { getRequestLocale, useTranslations } from "../i18n/ui";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const settings = await getSiteSettings();
const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(settings);
const fullTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const uiLocale = getRequestLocale(Astro);
const publicUrl = new URL(Astro.url);
publicUrl.pathname = Astro.originPathname;

const pageCtx = createPublicPageContext({
	url: publicUrl,
	locale: uiLocale,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const logoSrc = siteLogo?.url ?? "/images/logo.png";
const favicon = settings?.favicon?.url ?? "/favicon.svg";
const t = useTranslations(uiLocale);
---

<!doctype html>
<html lang={uiLocale} data-ui-locale={uiLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0873c5" />
		<link rel="icon" href={favicon} />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main-content">{t("layout.skipToContent")}</a>
		<Header
			logoSrc={logoSrc}
			companyName={siteTitle}
			phone={siteConfig.phone}
			phoneHref={siteConfig.phoneHref}
			content={content}
		/>

		<main id="main-content">
			<slot />
		</main>

		<Footer />
		<FloatingContact />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
