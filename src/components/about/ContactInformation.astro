---
import type {
  ContactInformationItem,
} from "../../data/contact";

interface Props {
  items: ContactInformationItem[];
  title?: string;
}

const {
  items,
  title = "Liên hệ",
} = Astro.props;

const companyName = items.find((item) => item.label === "Tên công ty");
const detailItems = items.filter((item) => item.label !== "Tên công ty");
---

<section aria-label={title}>
  {
    companyName && (
      <h2 class="mb-10 text-xl font-bold leading-tight text-[#1477b9] sm:text-2xl">
        {companyName.value}
      </h2>
    )
  }

  <dl class="mt-5">
    {
      detailItems.map((item) => (
        <div
          class:list={[
            "contact-information__row grid grid-cols-[120px_minmax(0,1fr)] items-baseline gap-4 py-4 sm:grid-cols-[220px_minmax(0,1fr)] sm:gap-6",
            { "contact-information__row--nowrap": item.noWrap },
          ]}
        >
          <dt class="font-bold text-[#1477b9]">
            {item.label}
          </dt>

          <dd class="m-0 min-w-0 text-base leading-7 text-slate-800">
            {item.href ? (
              <span
                class:list={[
                  "inline-flex items-baseline gap-2",
                  { "whitespace-nowrap": item.noWrap },
                ]}
              >
                <a
                  href={item.href}
                  class="font-semibold text-[#1477b9] transition-colors
                         hover:text-[#ef4a2f]"
                >
                  {item.value}
                </a>
                {item.additionalLinks?.map((link) => (
                  <>
                    <span aria-hidden="true">/</span>
                    <a
                      href={link.href}
                      class="font-semibold text-[#1477b9] transition-colors
                             hover:text-[#ef4a2f]"
                    >
                      {link.value}
                    </a>
                  </>
                ))}
              </span>
            ) : (
              item.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  @media (max-width: 639px) {
    .contact-information__row--nowrap {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 0.5rem;
    }

    .contact-information__row--nowrap dd {
      font-size: clamp(0.8rem, 3.8vw, 1rem);
    }
  }
</style>
