<header class="site-header relative z-50">


  <div class="border-b border-slate-100 bg-white">
    <Container class="flex min-h-24 items-center justify-between gap-2 py-4 sm:gap-4 md:gap-8">
      <div class="hidden shrink-0 min-[821px]:block">
        <BrandLogo logoSrc={logoSrc} companyName={companyName} />
      </div>
      <div class="shrink-0 min-[821px]:hidden">
        <a href={localizePath("/", locale)} class="block">
          <img src={logoSrc} alt={companyName} width="46" height="46" class="object-contain" />
        </a>
      </div>

      <div class="flex-1 min-w-0 px-1 sm:px-4">
        <SearchBar id="desktop-header-search" />
      </div>

      {/* Phần bên phải - Desktop */}
      <div class="hidden min-[821px]:flex items-center gap-4 shrink-0">
        <Hotline
          label="Hotline"
          phone={phone}
          phoneHref={phoneHref}
        />
        <span class="h-13 w-px bg-slate-200" aria-hidden="true"></span>
        <LanguageSwitcher content={content} />
      </div>

      {/* Phần bên phải - Mobile */}
      <div class="flex shrink-0 items-center min-[821px]:hidden">
        <Hotline
          label="Hotline"
          phone={phone}
          phoneHref={phoneHref}
          compact
        />
      </div>
    </Container>
  </div>

  <div class="hidden min-[821px]:block">
    <Navigation />
  </div>

  <div class="nav-shell relative min-[821px]:hidden">
    <Container>
      <MobileMenu content={content} />
    </Container>
  </div>
</header>
