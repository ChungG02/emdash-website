---
import { getRequestLocale, localizePath, stripLocalePrefix, useTranslations } from "../../i18n/ui";

interface Props {
  id?: string;
  formId?: string;
  action?: string;
  inputName?: string;
  placeholder?: string;
  value?: string;
}

const {
  id = "product-search",
  formId = "site-search-form",
  action = "/search",
  inputName = "q",
  placeholder,
  value,
} = Astro.props;

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);
const resolvedPlaceholder = placeholder ?? t("search.placeholder");
const resolvedAction = localizePath(action, locale);

const isSearchPage = stripLocalePrefix(Astro.originPathname).replace(/\/+$/, "") === "/search";
const currentValue = (
  value ??
  (isSearchPage ? Astro.url.searchParams.get(inputName) : "") ??
  ""
).slice(0, 120);
---

<form
  id={formId}
  action={resolvedAction}
  method="get"
  role="search"
  class="search-box w-full"
  data-site-search
>
  <label for={id} class="visually-hidden">{t("search.label")}</label>

  <input
    id={id}
    type="search"
    name={inputName}
    value={currentValue}
    placeholder={resolvedPlaceholder}
    maxlength="120"
    autocomplete="off"
  />

  <button type="submit" aria-label={t("search.submit")}>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      width="22"
      height="22"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
  </button>
</form>

<script>
  const initializeSearchScrollGuards = () => {
    document
      .querySelectorAll<HTMLInputElement>(
        "[data-site-search] input[type='search']",
      )
      .forEach((input) => {
        if (input.dataset.scrollGuardInitialized === "true") return;
        input.dataset.scrollGuardInitialized = "true";

        let scrollPosition = window.scrollY;
        let lastKeydownAt = 0;
        let restoreFrame = 0;

        const rememberKeyboardScrollPosition = () => {
          lastKeydownAt = performance.now();
          scrollPosition = window.scrollY;
        };

        const rememberNonKeyboardScrollPosition = () => {
          // On Chrome, beforeinput may fire after the browser has already moved
          // the sticky input. Do not let it overwrite the keydown position.
          if (performance.now() - lastKeydownAt > 250) {
            scrollPosition = window.scrollY;
          }
        };

        const restoreUnexpectedUpwardScroll = () => {
          window.cancelAnimationFrame(restoreFrame);
          let remainingFrames = 6;

          const restore = () => {
            if (document.activeElement !== input) return;

            const upwardShift = scrollPosition - window.scrollY;
            const headerHeight =
              input.closest<HTMLElement>(".site-header")?.offsetHeight ?? 0;

            // Chrome can nudge a focused control inside a sticky element upward
            // during caret updates. Only undo a small upward shift caused by input;
            // normal page scrolling and larger navigations remain untouched.
            if (upwardShift > 0 && upwardShift <= headerHeight + 32) {
              const root = document.documentElement;
              const previousScrollBehavior = root.style.scrollBehavior;
              root.style.scrollBehavior = "auto";
              window.scrollTo(window.scrollX, scrollPosition);
              root.style.scrollBehavior = previousScrollBehavior;
            }

            remainingFrames -= 1;
            if (remainingFrames > 0) {
              restoreFrame = window.requestAnimationFrame(restore);
            }
          };

          restoreFrame = window.requestAnimationFrame(restore);
        };

        input.addEventListener("keydown", rememberKeyboardScrollPosition);
        input.addEventListener("beforeinput", rememberNonKeyboardScrollPosition);
        input.addEventListener("input", restoreUnexpectedUpwardScroll);
      });
  };

  initializeSearchScrollGuards();
  document.addEventListener("astro:page-load", initializeSearchScrollGuards);
</script>
