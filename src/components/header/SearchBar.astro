---
interface Props {
  id?: string;
  formId?: string;
  action?: string;
  inputName?: string;
  placeholder?: string;
  value?: string;
}

const {
  id = "product-search",
  formId = "site-search-form",
  action = "/search",
  inputName = "q",
  placeholder = "Tìm kiếm sản phẩm...",
  value,
} = Astro.props;

const isSearchPage = Astro.url.pathname.replace(/\/+$/, "") === "/search";
const currentValue = (
  value ??
  (isSearchPage ? Astro.url.searchParams.get(inputName) : "") ??
  ""
).slice(0, 120);
---

<form
  id={formId}
  action={action}
  method="get"
  role="search"
  class="search-box w-full"
  data-site-search
>
  <label for={id} class="visually-hidden"> Tìm kiếm sản phẩm </label>

  <input
    id={id}
    type="search"
    name={inputName}
    value={currentValue}
    placeholder={placeholder}
    maxlength="120"
    autocomplete="off"
  />

  <button type="submit" aria-label="Tìm kiếm">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      width="22"
      height="22"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
  </button>
</form>

<script>
  const initializeSearchScrollGuard = (form: HTMLFormElement) => {
    if (form.dataset.scrollGuardInitialized === "true") return;

    const input = form.querySelector<HTMLInputElement>("input[type='search']");
    if (!input) return;

    form.dataset.scrollGuardInitialized = "true";

    let scrollX = 0;
    let scrollY = 0;
    let shouldPreserveScroll = false;
    let restoreFrame: number | undefined;

    const rememberScrollPosition = () => {
      const rect = input.getBoundingClientRect();
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;

      // Only suppress focus scrolling when the sticky search input is already
      // visible. Keyboard navigation to an off-screen input should still work.
      shouldPreserveScroll = rect.top >= 0 && rect.bottom <= viewportHeight;

      if (shouldPreserveScroll) {
        scrollX = window.scrollX;
        scrollY = window.scrollY;
      }
    };

    const restoreScrollPosition = () => {
      if (!shouldPreserveScroll) return;

      if (restoreFrame !== undefined) {
        window.cancelAnimationFrame(restoreFrame);
      }

      restoreFrame = window.requestAnimationFrame(() => {
        restoreFrame = undefined;

        if (document.activeElement !== input) return;
        if (
          Math.abs(window.scrollX - scrollX) < 1 &&
          Math.abs(window.scrollY - scrollY) < 1
        ) {
          return;
        }

        const scrollBehavior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = "auto";
        window.scrollTo(scrollX, scrollY);
        document.documentElement.style.scrollBehavior = scrollBehavior;
      });
    };

    input.addEventListener("pointerdown", rememberScrollPosition, {
      capture: true,
    });
    input.addEventListener("keydown", rememberScrollPosition, {
      capture: true,
    });
    input.addEventListener("beforeinput", rememberScrollPosition);
    input.addEventListener("focus", restoreScrollPosition);
    input.addEventListener("input", restoreScrollPosition);
  };

  const initializeAllSearchScrollGuards = () => {
    document
      .querySelectorAll<HTMLFormElement>("[data-site-search]")
      .forEach(initializeSearchScrollGuard);
  };

  initializeAllSearchScrollGuards();
  document.addEventListener(
    "astro:page-load",
    initializeAllSearchScrollGuards,
  );
</script>
