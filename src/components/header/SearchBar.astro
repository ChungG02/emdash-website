---
import { getUiLocale, useTranslations } from "../../i18n/ui";

interface Props {
  id?: string;
  formId?: string;
  action?: string;
  inputName?: string;
  placeholder?: string;
  value?: string;
}

const {
  id = "product-search",
  formId = "site-search-form",
  action = "/search",
  inputName = "q",
  placeholder,
  value,
} = Astro.props;

const t = useTranslations(getUiLocale(Astro.cookies));
const resolvedPlaceholder = placeholder ?? t("search.placeholder");

const isSearchPage = Astro.url.pathname.replace(/\/+$/, "") === "/search";
const currentValue = (
  value ??
  (isSearchPage ? Astro.url.searchParams.get(inputName) : "") ??
  ""
).slice(0, 120);
---

<form
  id={formId}
  action={action}
  method="get"
  role="search"
  class="search-box w-full"
  data-site-search
>
  <label for={id} class="visually-hidden">{t("search.label")}</label>

  <input
    id={id}
    type="search"
    name={inputName}
    value={currentValue}
    placeholder={resolvedPlaceholder}
    maxlength="120"
    autocomplete="off"
  />

  <button type="submit" aria-label={t("search.submit")}>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      width="22"
      height="22"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
  </button>
</form>
