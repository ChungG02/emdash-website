---
interface Props {
  id?: string;
  formId?: string;
  action?: string;
  inputName?: string;
  placeholder?: string;
  value?: string;
}

const {
  id = "product-search",
  formId = "site-search-form",
  action = "/search",
  inputName = "q",
  placeholder = "Tìm kiếm sản phẩm...",
  value,
} = Astro.props;

const isSearchPage = Astro.url.pathname.replace(/\/+$/, "") === "/search";
const currentValue = (
  value ??
  (isSearchPage ? Astro.url.searchParams.get(inputName) : "") ??
  ""
).slice(0, 120);
---

<form
  id={formId}
  action={action}
  method="get"
  role="search"
  class="search-box w-full"
  data-site-search
>
  <label for={id} class="visually-hidden"> Tìm kiếm sản phẩm </label>

  <input
    id={id}
    type="search"
    name={inputName}
    value={currentValue}
    placeholder={placeholder}
    maxlength="120"
    autocomplete="off"
  />

  <button type="submit" aria-label="Tìm kiếm">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      width="22"
      height="22"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
  </button>
</form>

<script>
  const SEARCH_SCROLL_LOCK_MS = 500;
  const SEARCH_SCROLL_RESTORE_DELAYS = [50, 150, 350];

  const initializeSearchScrollGuard = (form: HTMLFormElement) => {
    if (form.dataset.scrollGuardInitialized === "true") return;

    const input = form.querySelector<HTMLInputElement>("input[type='search']");
    if (!input) return;

    form.dataset.scrollGuardInitialized = "true";

    let preservedScrollPosition: { x: number; y: number } | null = null;
    let scrollLockExpiresAt = 0;
    let restoreFrame: number | undefined;
    let restoreTimeouts: number[] = [];

    const isInputVisible = () => {
      const rect = input.getBoundingClientRect();
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;

      return rect.top >= 0 && rect.bottom <= viewportHeight;
    };

    const rememberScrollPosition = (force = false) => {
      if (!isInputVisible()) return;

      const now = window.performance.now();

      // Keep the position captured before focus instead of replacing it with
      // a position produced by a delayed browser focus scroll.
      if (
        force ||
        preservedScrollPosition === null ||
        now > scrollLockExpiresAt
      ) {
        preservedScrollPosition = {
          x: window.scrollX,
          y: window.scrollY,
        };
      }

      scrollLockExpiresAt = now + SEARCH_SCROLL_LOCK_MS;
    };

    const clearScheduledRestores = () => {
      if (restoreFrame !== undefined) {
        window.cancelAnimationFrame(restoreFrame);
        restoreFrame = undefined;
      }

      restoreTimeouts.forEach((timeout) => window.clearTimeout(timeout));
      restoreTimeouts = [];
    };

    const restoreScrollPosition = () => {
      if (
        preservedScrollPosition === null ||
        document.activeElement !== input ||
        window.performance.now() > scrollLockExpiresAt
      ) {
        return;
      }

      const { x, y } = preservedScrollPosition;

      if (
        Math.abs(window.scrollX - x) < 1 &&
        Math.abs(window.scrollY - y) < 1
      ) {
        return;
      }

      const scrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = "auto";
      window.scrollTo(x, y);
      document.documentElement.style.scrollBehavior = scrollBehavior;
    };

    const scheduleScrollRestore = () => {
      clearScheduledRestores();
      restoreScrollPosition();
      window.queueMicrotask(restoreScrollPosition);

      restoreFrame = window.requestAnimationFrame(() => {
        restoreScrollPosition();

        restoreFrame = window.requestAnimationFrame(() => {
          restoreFrame = undefined;
          restoreScrollPosition();
        });
      });

      restoreTimeouts = SEARCH_SCROLL_RESTORE_DELAYS.map((delay) =>
        window.setTimeout(restoreScrollPosition, delay),
      );
    };

    const startScrollLock = (force = false) => {
      rememberScrollPosition(force);
      scheduleScrollRestore();
    };

    const releaseScrollLock = () => {
      clearScheduledRestores();
      preservedScrollPosition = null;
      scrollLockExpiresAt = 0;
    };

    input.addEventListener("pointerdown", () => {
      startScrollLock(true);

      // Focus at the current viewport position before the browser performs
      // its default focus action for the sticky header input.
      input.focus({ preventScroll: true });
      scheduleScrollRestore();
    });
    input.addEventListener("keydown", () => startScrollLock());
    input.addEventListener("beforeinput", () => startScrollLock());
    input.addEventListener("compositionstart", () => startScrollLock());
    input.addEventListener("compositionupdate", () => startScrollLock());
    input.addEventListener("focus", scheduleScrollRestore);
    input.addEventListener("input", scheduleScrollRestore);
    input.addEventListener("blur", releaseScrollLock);

    window.addEventListener("scroll", restoreScrollPosition, {
      capture: true,
      passive: true,
    });

    // Deliberate wheel/touch scrolling should remain available while the
    // input is focused; only browser-driven movement during typing is locked.
    window.addEventListener("wheel", releaseScrollLock, { passive: true });
    window.addEventListener("touchmove", releaseScrollLock, { passive: true });
  };

  const initializeAllSearchScrollGuards = () => {
    document
      .querySelectorAll<HTMLFormElement>("[data-site-search]")
      .forEach(initializeSearchScrollGuard);
  };

  initializeAllSearchScrollGuards();
  document.addEventListener(
    "astro:page-load",
    initializeAllSearchScrollGuards,
  );
</script>
