---
import FlagIcon from "./FlagIcon.astro";
import { languages } from "../../data/languages";
import {
  getUiLocale,
  UI_LOCALE_COOKIE,
  useTranslations,
} from "../../i18n/ui";

const locale = getUiLocale(Astro.cookies);
const t = useTranslations(locale);
const currentLang = languages.find((language) => language.code === locale) ?? languages[0];
const otherLangs = languages.filter((language) => language.code !== locale);
---

<!-- Mobile version: Row of flags -->
<div
  class="flex items-center gap-2 min-[821px]:hidden"
  role="navigation"
  aria-label={t("language.select")}
>
  {
    languages.map((language) => {
      const isCurrent = language.code === locale;

      return (
        <button
          type="button"
          data-ui-locale={language.code}
          lang={language.code}
          title={language.label}
          aria-label={t("language.switchTo", { language: language.label })}
          aria-current={isCurrent ? "page" : undefined}
          disabled={isCurrent}
          class:list={[
            "block overflow-hidden rounded-sm border border-slate-200 shadow-sm",
            "transition duration-150 hover:-translate-y-0.5 hover:shadow-md",
            "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1477b9]",
            isCurrent && "ring-2 ring-[#1477b9] ring-offset-1",
          ]}
        >
          <FlagIcon code={language.code} />
        </button>
      );
    })
  }
</div>

<!-- Desktop version: Dropdown -->
<div
  class="relative group hidden min-[821px]:block"
  role="navigation"
  aria-label={t("language.select")}
>
  <button
    type="button"
    class="flex items-center gap-2 py-2 cursor-pointer focus:outline-none"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <div class="block overflow-hidden rounded-sm shadow-sm transition hover:shadow-md border border-slate-200">
      <FlagIcon code={currentLang.code} />
    </div>
    <span class="font-bold text-[15px] uppercase text-[#005b9f]">{currentLang.code}</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#005b9f] transition-transform duration-200 group-hover:rotate-180">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </button>

  <div class="absolute right-0 top-full pt-2 z-50 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
    <div class="w-max bg-white rounded-md shadow-lg border border-slate-200 py-2 flex flex-col">
      {
        otherLangs.map((language) => (
          <button
            type="button"
            data-ui-locale={language.code}
            lang={language.code}
            title={language.label}
            aria-label={t("language.switchTo", { language: language.label })}
            class="flex items-center gap-3 px-4 py-2 hover:bg-slate-50 transition-colors"
          >
            <div class="block overflow-hidden rounded-sm border border-slate-200 shadow-sm">
              <FlagIcon code={language.code} />
            </div>
            <span class="text-sm font-medium uppercase text-slate-700">{language.code}</span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<script is:inline define:vars={{ cookieName: UI_LOCALE_COOKIE }}>
  document.querySelectorAll("[data-ui-locale]").forEach((button) => {
    if (!(button instanceof HTMLButtonElement) || button.dataset.bound === "true") return;

    button.dataset.bound = "true";
    button.addEventListener("click", () => {
      const locale = button.dataset.uiLocale;
      if (!locale) return;

      document.cookie = `${cookieName}=${encodeURIComponent(locale)}; Path=/; Max-Age=31536000; SameSite=Lax`;
      window.location.reload();
    });
  });
</script>
