---
import { Image } from "emdash/ui";
import type { ProductCardItem } from "../../modules/types/product.type";
import { getRequestLocale, useTranslations } from "../../i18n/ui";

interface Props {
  product: ProductCardItem;
}

const { product } = Astro.props;
const t = useTranslations(getRequestLocale(Astro));
---

<article class="product-card" data-product-card>
  <a
    href={product.href}
    class="product-image"
    aria-label={t("common.view", { name: product.name })}
  >
    {
      product.image ? (
        <Image image={product.image} />
      ) : (
        <div class="product-image__placeholder">
          {t("common.noImage")}
        </div>
      )
    }
  </a>

  <div class="product-body">
    <h3 class="product-name">
      <a href={product.href}>{product.name}</a>
    </h3>

    <a
      href={product.href}
      class="product-action"
      data-product-request={product.name}
    >
      {t("common.viewDetails")}
    </a>
  </div>
</article>

<style>
  .product-image__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: #64748b;
    background: #f3f4f6;
  }
</style>
