---
import { Image } from "emdash/ui";
import type { Product } from "../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const href = product.href ?? "#lien-he";
---

<article class="product-card" data-product-card>
  <a href={href} class="product-image" aria-label={`Xem ${product.name}`}>
    {
      typeof product.image === "string" ? (
        <img
          src={product.image}
          data-fallback-src={product.fallbackImage}
          alt={product.alt}
          width="650"
          height="650"
          loading="lazy"
          decoding="async"
          style={product.objectPosition
            ? `object-position:${product.objectPosition}`
            : undefined}
        />
      ) : (
        <Image image={product.image} />
      )
    }
  </a>

  <div class="product-body">
    <h3 class="product-name">
      <a href={href}>{product.name}</a>
    </h3>
    <a
      href={href}
      class="product-action"
      data-product-request={product.name}
    >
      Xem chi tiết
    </a>
  </div>
</article>

<script>
  const initializeFallbackImages = () => {
    document
      .querySelectorAll<HTMLImageElement>("img[data-fallback-src]")
      .forEach((image) => {
        if (image.dataset.fallbackInitialized === "true") return;
        image.dataset.fallbackInitialized = "true";

        image.addEventListener("error", () => {
          const fallback = image.dataset.fallbackSrc;
          if (!fallback || image.getAttribute("src") === fallback) return;
          image.dataset.fallbackApplied = "true";
          image.src = fallback;
        });
      });
  };

  initializeFallbackImages();
  document.addEventListener("astro:page-load", initializeFallbackImages);
</script>
