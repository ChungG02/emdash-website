---
import Container from "../common/Container.astro";
import { getRequestLocale, useTranslations } from "../../i18n/ui";

const t = useTranslations(getRequestLocale(Astro));
---

<section class="contact-section" id="lien-he">
  <Container class="contact-layout">
    <div class="contact-heading">
      <span>{t("contact.eyebrow")}</span>
      <h2>{t("contact.title")}</h2>
      <p>{t("contact.description")}</p>

      <div class="contact-benefits" aria-label={t("contact.benefitsLabel")}>
        <div class="contact-benefit">
          <span class="contact-benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 14a8 8 0 0 1 16 0" />
              <path d="M18 19c0 1.1-.9 2-2 2h-1" />
              <path d="M4 14v3a2 2 0 0 0 2 2h1v-7H6a2 2 0 0 0-2 2Z" />
              <path d="M20 14v3a2 2 0 0 1-2 2h-1v-7h1a2 2 0 0 1 2 2Z" />
            </svg>
          </span>
          <span>
            <strong>{t("contact.fastTitle")}</strong>
            <small>{t("contact.fastDescription")}</small>
          </span>
        </div>

        <div class="contact-benefit">
          <span class="contact-benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3h9l3 3v15H6z" />
              <path d="M14 3v4h4M9 11h6M9 15h6M9 19h4" />
              <path d="m16.5 15.5 1 1 2-2" />
            </svg>
          </span>
          <span>
            <strong>{t("contact.solutionTitle")}</strong>
            <small>{t("contact.solutionDescription")}</small>
          </span>
        </div>

        <div class="contact-benefit">
          <span class="contact-benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 5 6v5c0 4.8 2.8 8.2 7 10 4.2-1.8 7-5.2 7-10V6z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </span>
          <span>
            <strong>{t("contact.privacyTitle")}</strong>
            <small>{t("contact.privacyDescription")}</small>
          </span>
        </div>
      </div>
    </div>

    <form
      class="contact-form"
      method="POST"
      action="/_emdash/api/plugins/emdash-forms/submit"
      data-contact-form
      novalidate
    >
      <input type="hidden" name="formId" value="contact-form" />

      <div
        aria-hidden="true"
        style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;"
      >
        <label for="contact-website">Website</label>
        <input
          id="contact-website"
          name="_hp"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="form-grid">
        <div class="field">
          <label class="visually-hidden" for="contact-name">{t("contact.name")}</label>
          <span class="field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-5 0-9 2.5-9 5.5V22h18v-2.5C21 16.5 17 14 12 14Z" /></svg>
          </span>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder={`${t("contact.name")} *`}
            required
          />
        </div>

        <div class="field">
          <label class="visually-hidden" for="contact-phone"
            >{t("contact.phone")}</label
          >
          <span class="field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="m20.5 15.8-4.1-1.8a1.2 1.2 0 0 0-1.4.3l-1.8 2.2a15.8 15.8 0 0 1-5.7-5.7L9.7 9a1.2 1.2 0 0 0 .3-1.4L8.2 3.5A1.2 1.2 0 0 0 6.8 2.8L3 3.7A1.2 1.2 0 0 0 2 4.9C2 14.3 9.7 22 19.1 22a1.2 1.2 0 0 0 1.2-1l.9-3.8a1.2 1.2 0 0 0-.7-1.4Z" /></svg>
          </span>
          <input
            id="contact-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            placeholder={`${t("contact.phone")} *`}
            required
          />
        </div>

        <div class="field field-full">
          <label class="visually-hidden" for="contact-email">Email</label>
          <span class="field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m4 6 8 7 8-7" /></svg>
          </span>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="Email *"
            required
          />
        </div>
        <div class="field field-full">
          <label class="visually-hidden" for="contact-company">{t("contact.company")}</label>
          <span class="field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V5a2 2 0 0 1 2-2h8v18M14 9h4a2 2 0 0 1 2 2v10M2 21h20" /><path d="M8 7h2M8 11h2M8 15h2M17 13h1M17 17h1" /></svg>
          </span>
          <input
            id="contact-company"
            name="company"
            type="text"
            autocomplete="company"
            placeholder={`${t("contact.company")} *`}
            required
          />
        </div>

        <div class="field field-full">
          <label class="visually-hidden" for="contact-address">{t("contact.address")}</label>
          <span class="field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" /></svg>
          </span>
          <input
            id="contact-address"
            name="address"
            type="text"
            autocomplete="address"
            placeholder={`${t("contact.address")} *`}
            required
          />
        </div>

        <div class="field field-full">
          <label class="visually-hidden" for="contact-message"
            >{t("contact.message")}</label
          >
          <span class="field-icon field-icon-textarea" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h10l4 4v14H5z" /><path d="M14 3v5h5M8 12h8M8 16h5" /><path d="m15 18 4-4 1 1-4 4-2 .5z" /></svg>
          </span>
          <textarea
            id="contact-message"
            name="message"
            placeholder={t("contact.messagePlaceholder")}
            required></textarea>
        </div>
      </div>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
          {t("contact.consent")}
        </span>
      </label>

      <div class="submit-wrap">
        <button class="submit-button" type="submit">{t("contact.submit")}</button>
      </div>

      <p
        class="form-demo-note"
        data-contact-form-status
        role="status"
        aria-live="polite"
      ></p>
    </form>
  </Container>
</section>

<script>
  interface SubmitResult {
    success?: boolean;
    message?: string;
    redirect?: string;
    errors?: Array<{ field?: string; message?: string }>;
  }

  const isRecord = (value: unknown): value is Record<string, unknown> =>
    typeof value === "object" && value !== null && !Array.isArray(value);

  const parseSubmitResult = (body: unknown): SubmitResult => {
    if (!isRecord(body)) return {};
    return isRecord(body.data)
      ? (body.data as SubmitResult)
      : (body as SubmitResult);
  };

  const getResponseError = (body: unknown): string | undefined => {
    if (!isRecord(body) || !isRecord(body.error)) return undefined;
    return typeof body.error.message === "string"
      ? body.error.message
      : undefined;
  };

  const notify = (message: string) => {
    document.dispatchEvent(
      new CustomEvent("site:toast", { detail: { message } }),
    );
  };

  const initializeContactForm = (form: HTMLFormElement) => {
    if (form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";

    const phone = form.querySelector<HTMLInputElement>("[name='phone']");
    const message = form.querySelector<HTMLTextAreaElement>("[name='message']");
    const submitButton = form.querySelector<HTMLButtonElement>(
      "button[type='submit']",
    );
    const status = form.querySelector<HTMLElement>(
      "[data-contact-form-status]",
    );

    const setStatus = (text: string) => {
      if (status) status.textContent = text;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      setStatus("");

      if (!form.reportValidity()) {
        notify(form.dataset.requiredError ?? "");
        return;
      }

      const phonePattern = /^[0-9+\s().-]{8,20}$/;
      if (!phonePattern.test(phone?.value.trim() ?? "")) {
        notify(form.dataset.phoneError ?? "");
        phone?.focus();
        return;
      }

      const originalButtonLabel =
        submitButton?.textContent ?? "Gửi yêu cầu";

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Đang gửi...";
      }
      form.setAttribute("aria-busy", "true");
      setStatus("Đang gửi thông tin...");

      try {
        const formData = new FormData(form);
        const formId = String(formData.get("formId") ?? "contact-form");
        const data: Record<string, unknown> = {};

        for (const [key, value] of formData) {
          if (key === "formId" || typeof value !== "string") continue;

          const existing = data[key];
          if (existing === undefined) {
            data[key] = value;
          } else if (Array.isArray(existing)) {
            existing.push(value);
          } else {
            data[key] = [existing, value];
          }
        }

        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({ formId, data }),
        });

        const responseBody: unknown = await response.json().catch(() => null);
        const result = parseSubmitResult(responseBody);

        if (!response.ok || result.success !== true) {
          const errorMessage =
            result.errors?.find((error) => error.message)?.message ??
            result.message ??
            getResponseError(responseBody) ??
            "Không thể gửi thông tin. Vui lòng thử lại.";

          setStatus(errorMessage);
          notify(errorMessage);
          return;
        }

        const successMessage =
          result.message ??
          "Thông tin đã được gửi thành công. Chúng tôi sẽ sớm liên hệ lại.";

        setStatus(successMessage);
        notify(successMessage);
        form.reset();

        if (result.redirect) {
          const redirectUrl = new URL(result.redirect, window.location.href);
          if (["http:", "https:"].includes(redirectUrl.protocol)) {
            window.location.assign(redirectUrl.href);
          }
        }
      } catch (error) {
        console.error("[contact-form] Submission failed", error);
        const errorMessage =
          "Không thể kết nối máy chủ. Vui lòng thử lại sau.";
        setStatus(errorMessage);
        notify(errorMessage);
      } finally {
        form.removeAttribute("aria-busy");
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalButtonLabel;
        }
      }
    });

    document
      .querySelectorAll<HTMLElement>("[data-product-request]")
      .forEach((link) => {
        link.addEventListener("click", () => {
          const productName = link.dataset.productRequest;
          if (message && productName) {
            message.value = (form.dataset.productRequestTemplate ?? "{name}")
              .replace("{name}", productName);
          }
        });
      });

  };

  const initializeAllContactForms = () => {
    document
      .querySelectorAll<HTMLFormElement>("[data-contact-form]")
      .forEach(initializeContactForm);
  };

  initializeAllContactForms();
  document.addEventListener("astro:page-load", initializeAllContactForms);
</script>
