---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";
import Container from "../common/Container.astro";
import SectionHeading from "./SectionHeading.astro";

interface NewsCardData {
  title: string;
  description?: string;
  image?: MediaValue;
  alt: string;
  href: string;
  date?: string;
}

interface Props {
  items: NewsCardData[];
}

const { items } = Astro.props;
---

<section class="news-section" id="tin-tuc">
  <Container>
    <SectionHeading title="TIN TỨC" linkHref="/posts" />

    {
      items.length > 0 ? (
        <div class="news-grid">
          {items.map((item) => (
            <article class="news-card">
              {item.image && (
                <a href={item.href} class="news-image" aria-label={`Đọc ${item.title}`}>
                  <Image image={item.image} alt={item.alt} width={850} height={500} />
                </a>
              )}

              <div class="news-body">
                {item.date && <small>{item.date}</small>}
                <h3><a href={item.href}>{item.title}</a></h3>
                {item.description && <p>{item.description}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="news-empty">Chưa có bài viết nào được xuất bản.</p>
      )
    }
  </Container>
</section>
