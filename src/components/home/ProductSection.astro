---
import Container from "../common/Container.astro";
import SectionHeading from "./SectionHeading.astro";
import ProductCard from "./ProductCard.astro";
import type { ProductSectionData } from "../../modules/types/product.type";
import { getUiLocale, useTranslations } from "../../i18n/ui";

interface Props {
  section: ProductSectionData;
}

const { section } = Astro.props;
const t = useTranslations(getUiLocale(Astro.cookies));

const isCarousel =
  section.id === "bang-dinh" &&
  section.products.length > 4;
---

<section
  class:list={[
    "product-section",
    section.alternate && "is-alternate",
  ]}
  id={section.id}
>
  <Container>
    <SectionHeading
      title={section.title}
      linkHref={`/product-category/${section.id}`}
    />

    {
      section.products.length === 0 ? (
        <p class="product-section__empty">
          {t("products.emptyCategory")}
        </p>
      ) : isCarousel ? (
        <div class="product-carousel" data-product-carousel>
          <div
            class="product-carousel__viewport"
            data-product-carousel-viewport
            tabindex="0"
            aria-label={t("products.listLabel", { name: section.title })}
          >
            <div class="product-grid product-carousel__track">
              {section.products.map((product) => (
                <ProductCard product={product} />
              ))}
            </div>
          </div>

          <button
            type="button"
            class="product-carousel__next"
            data-product-carousel-next
            aria-label={t("products.next")}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>
      ) : (
        <div class="product-grid">
          {section.products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      )
    }
  </Container>
</section>

<style>
  .product-section__empty {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    color: var(--muted);
    background: var(--background);
  }
</style>

<script>
  const initializeProductCarousel = (carousel: HTMLElement) => {
    if (carousel.dataset.initialized === "true") return;

    carousel.dataset.initialized = "true";

    const viewport = carousel.querySelector<HTMLElement>(
      "[data-product-carousel-viewport]",
    );

    const nextButton = carousel.querySelector<HTMLButtonElement>(
      "[data-product-carousel-next]",
    );

    if (!viewport || !nextButton) return;

    const updateButtonVisibility = () => {
      nextButton.hidden =
        viewport.scrollWidth <= viewport.clientWidth + 1;
    };

    nextButton.addEventListener("click", () => {
      const maxScroll =
        viewport.scrollWidth - viewport.clientWidth;

      const isAtEnd =
        viewport.scrollLeft >= maxScroll - 2;

      viewport.scrollTo({
        left: isAtEnd
          ? 0
          : Math.min(
              viewport.scrollLeft + viewport.clientWidth,
              maxScroll,
            ),
        behavior: "smooth",
      });
    });

    const resizeObserver = new ResizeObserver(
      updateButtonVisibility,
    );

    resizeObserver.observe(viewport);
    updateButtonVisibility();
  };

  const initializeAllProductCarousels = () => {
    document
      .querySelectorAll<HTMLElement>(
        "[data-product-carousel]",
      )
      .forEach(initializeProductCarousel);
  };

  initializeAllProductCarousels();

  document.addEventListener(
    "astro:page-load",
    initializeAllProductCarousels,
  );
</script>
