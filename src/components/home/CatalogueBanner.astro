---
import Container from "../common/Container.astro";
import { getUiLocale, useTranslations } from "../../i18n/ui";

const t = useTranslations(getUiLocale(Astro.cookies));
---

<section class="catalogue-banner" id="catalogue">
  <Container class="catalogue-inner">
    <div>
      <h2>{t("catalogue.title")}</h2>
      <p>{t("catalogue.description")}</p>
    </div>

    <a
      href="/downloads/ho-so-nang-luc-cong-ty-nhua-thai-son.pdf"
      class="product-action catalogue-action"
      download="ho-so-nang-luc-cong-ty-nhua-thai-son.docx"
      aria-label={t("catalogue.downloadLabel")}
    >
      {t("catalogue.download")}
    </a>
  </Container>
</section>
