---
import Container from "../common/Container.astro";
---

<section class="catalogue-banner" id="catalogue">
  <Container class="catalogue-inner">
    <div>
      <h2>Catalogue sản phẩm Thái Sơn Plastic</h2>
      <p>
        Nhận catalogue tổng hợp để tham khảo nhanh các nhóm vật tư và giải pháp
        đóng gói dành cho doanh nghiệp.
      </p>
    </div>

    <a
      href="#lien-he"
      class="product-action catalogue-action"
      data-catalogue-request
    >
      Nhận catalogue
    </a>
  </Container>
</section>
