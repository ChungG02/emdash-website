---
import Container from "../common/Container.astro";
import { getRequestLocale, useTranslations } from "../../i18n/ui";

const t = useTranslations(getRequestLocale(Astro));

const commitments = [
  {
    icon: "▦",
    lineOne: t("trustStrip.manufacturerLineOne"),
    lineTwo: t("trustStrip.manufacturerLineTwo"),
  },
  {
    icon: "✓",
    lineOne: t("trustStrip.qualityLineOne"),
    lineTwo: t("trustStrip.qualityLineTwo"),
  },
  {
    icon: "◇",
    lineOne: t("trustStrip.partnerLineOne"),
    lineTwo: t("trustStrip.partnerLineTwo"),
  },
  {
    icon: "↗",
    lineOne: t("trustStrip.deliveryLineOne"),
    lineTwo: t("trustStrip.deliveryLineTwo"),
  },
  {
    icon: "☎",
    lineOne: t("trustStrip.supportLineOne"),
    lineTwo: t("trustStrip.supportLineTwo"),
  },
];
---

<section class="factory-strip" aria-label={t("trustStrip.label")}>
  <Container class="factory-grid">
    {
      commitments.map((commitment) => (
        <div class="factory-item">
          <span class="factory-icon" aria-hidden="true">
            {commitment.icon}
          </span>
          <span>
            {commitment.lineOne}
            <br />
            {commitment.lineTwo}
          </span>
        </div>
      ))
    }
  </Container>
</section>
