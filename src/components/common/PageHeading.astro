---
interface Props {
  eyebrow?: string;
  title: string;
  eyebrowClass?: string;
}

const {
  eyebrow,
  title,
  eyebrowClass,
} = Astro.props;
---

<header class="border-b border-slate-200 pb-5">
  {
    eyebrow && (
      <p
        class:list={[
          "mb-1 font-bold uppercase tracking-wide text-[#2589bd]",
          eyebrowClass ?? "text-xs",
        ]}
      >
        {eyebrow}
      </p>
    )
  }

  <h1 class="text-3xl font-bold text-slate-800 sm:text-4xl">
    {title}
  </h1>
</header>
