---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";
import { getUiLocale, useTranslations } from "../../../i18n/ui";

interface Props {
  title: string;
  href: string;
  featuredImage?: MediaValue | string;
}

const { title, href, featuredImage } = Astro.props;
const t = useTranslations(getUiLocale(Astro.cookies));
---

<article class="product-card">
  <a href={href} class="product-card__image-link" aria-label={t("common.view", { name: title })}>
    <div class="product-card__image">
      {
        featuredImage ? (
          <Image image={featuredImage} />
        ) : (
          <div class="product-card__placeholder">{t("common.noImage")}</div>
        )
      }
    </div>
  </a>

  <div class="product-card__content">
    <h3 class="product-card__title">
      <a href={href}>{title}</a>
    </h3>

    <a href={href} class="product-card__button">{t("common.viewDetails")}</a>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    width: 100%;
    max-width: 292px;
    height: 100%;
    margin: 0 auto;
    overflow: hidden;
    flex-direction: column;
    border: 1px solid #d7e0e8;
    border-radius: 4px;
    background: #ffffff;
    box-shadow: 0 8px 24px rgb(15 23 42 / 6%);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: #83bce3;
    box-shadow: 0 14px 30px rgb(15 23 42 / 12%);
  }

  .product-card__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .product-card__image {
    width: 100%;
    height: 245px;
    padding: 14px;
    overflow: hidden;
    border-bottom: 1px solid #edf0f2;
    background: #ffffff;
    box-sizing: border-box;
  }

  .product-card__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    object-fit: cover;
    aspect-ratio: 1 / 1;
    box-sizing: border-box;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image :global(img) {
    transform: scale(1.035);
  }

  .product-card__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: #64748b;
    background: #f3f4f6;
  }

  .product-card__content {
    display: flex;
    min-height: 112px;
    padding: 12px 14px 14px;
    align-items: center;
    flex: 1;
    flex-direction: column;
  }

  .product-card__title {
    display: -webkit-box;
    min-height: 40px;
    margin: 0;
    overflow: hidden;
    color: #0878c1;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .product-card__button {
    margin-top: 10px;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title a:hover {
    color: #075e96;
  }

  .product-card__button {
    display: inline-flex;
    min-width: 124px;
    min-height: 40px;
    margin-top: 13px;
    padding: 8px 16px;
    align-items: center;
    justify-content: center;
    border: 1px solid #0878c1;
    color: #0878c1;
    background: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .product-card__button:hover {
    border-color: var(--orange);
    color: #ffffff;
    background: var(--orange);
  }

  @media (max-width: 560px) {
    .product-card__image {
      height: 165px;
      padding: 7px;
    }
  }
</style>
