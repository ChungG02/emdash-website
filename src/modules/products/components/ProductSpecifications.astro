---
import { contactInfo } from "../../../data/contact";

interface Props {
  origin?: string;
  availability?: string;
  sizes?: string[];
}

const { origin, availability, sizes = [] } = Astro.props;
---

<div class="product-specifications">
  {
    origin && (
      <p class="product-specifications__row">
        <strong>Xuất xứ:</strong>
        <span>{origin}</span>
      </p>
    )
  }

  {
    availability && (
      <p class="product-specifications__row">
        <strong>Tình trạng:</strong>
        <span class="product-specifications__availability">{availability}</span>
      </p>
    )
  }

  <span class="product-hotline__content">
    <a
      href="#lien-he"
      class="product-hotline__label"
      aria-label="Cuộn đến biểu mẫu đăng ký thông tin liên hệ"
    >
      Báo Giá Liên Hệ
    </a>
    <strong class="product-hotline__number">
      {contactInfo.hotline.display}
    </strong>
    <strong class="product-hotline__number"> 097 781 88 18 </strong>
  </span>
  <!-- </a> -->

  {
    sizes.length > 0 && (
      <div class="product-specifications__sizes">
        <p class="product-specifications__sizes-title">Kích thước</p>

        <div class="product-specifications__size-list">
          {sizes.map((size) => (
            <span class="product-specifications__size">{size}</span>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  .product-specifications {
    margin-top: 28px;
  }

  .product-specifications__row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 18px;
    font-size: 17px;
    line-height: 1.5;
  }

  .product-specifications__row strong {
    font-weight: 700;
  }

  .product-specifications__availability {
    color: #16803c;
    font-weight: 600;
  }

  .product-specifications__sizes {
    margin-top: 30px;
  }

  .product-specifications__sizes-title {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-specifications__size-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .product-specifications__size {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border: 1px solid #9ca3af;
    border-radius: 4px;
    background: #ffffff;
    color: #111827;
    font-size: 15px;
    font-weight: 600;
  }

  .product-hotline {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 6px 0 28px;
    color: inherit;
    text-decoration: none;
  }

  .product-hotline__icon {
    display: flex;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eff8ff;
    color: #1477b9;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .product-hotline__icon svg {
    width: 25px;
    height: 25px;
  }

  .product-hotline__content {
    display: flex;
    flex-direction: column;
  }

  .product-hotline__label {
    width: fit-content;
    color: #6b7280;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .product-hotline__label:hover,
  .product-hotline__label:focus-visible {
    outline: 0;
    color: #1477b9;
    text-decoration-color: currentColor;
  }

  .product-hotline__number {
    color: #10466e;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.5px;
  }

  .product-hotline:hover .product-hotline__icon {
    background: #dbeeff;
    transform: scale(1.05);
  }

  .product-hotline:hover .product-hotline__number {
    color: #1477b9;
  }

  @media (max-width: 600px) {
    .product-hotline__number {
      font-size: 21px;
    }
  }
</style>
