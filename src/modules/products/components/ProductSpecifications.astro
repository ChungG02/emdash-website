---
// import { contactInfo } from "../../../data/contact";
import { getUiLocale, useTranslations } from "../../../i18n/ui";

interface Props {
  origin?: string;
  availability?: string;
  sizes?: string[];
}

const { origin, availability, sizes = [] } = Astro.props;
const t = useTranslations(getUiLocale(Astro.cookies));
---

<div class="product-specifications">
  {
    origin && (
      <p class="product-specifications__row">
        <strong>{t("products.origin")}:</strong>
        <span>{origin}</span>
      </p>
    )
  }

  {
    availability && (
      <p class="product-specifications__row">
        <strong>{t("products.availability")}:</strong>
        <span class="product-specifications__availability">{availability}</span>
      </p>
    )
  }

  <!-- <a
    href={contactInfo.hotline.href}
    class="product-hotline"
    aria-label={`Gọi ${contactInfo.hotline.label} ${contactInfo.hotline.display}`}
  > -->
  <!-- <span class="product-hotline__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2
				19.79 19.79 0 0 1-8.63-3.07
				19.5 19.5 0 0 1-6-6
				19.79 19.79 0 0 1-3.07-8.67
				A2 2 0 0 1 4.11 2h3
				a2 2 0 0 1 2 1.72
				12.84 12.84 0 0 0 .7 2.81
				2 2 0 0 1-.45 2.11L8.09 9.91
				a16 16 0 0 0 6 6l1.27-1.27
				a2 2 0 0 1 2.11-.45
				12.84 12.84 0 0 0 2.81.7
				A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
    </span> -->

  <!-- <span class="product-hotline__content">
    <span class="product-hotline__label">{t("products.contactForPrice")}</span>
    <strong class="product-hotline__number">
      {contactInfo.hotline.display}
    </strong>
    <strong class="product-hotline__number"> 097 781 88 18 </strong>
  </span> -->
  <!-- </a> -->

  {
    sizes.length > 0 && (
      <div class="product-specifications__sizes">
        <p class="product-specifications__sizes-title">{t("products.sizes")}</p>

        <div class="product-specifications__size-list">
          {sizes.map((size) => (
            <span class="product-specifications__size">{size}</span>
          ))}
        </div>
      </div>
    )
  }

  <div class="product-specifications__quote">
    <a
      href="#lien-he"
      class="product-specifications__quote-button"
      aria-label="Cuộn đến biểu mẫu đăng ký thông tin liên hệ"
    >
      Nhận báo giá
    </a>
  </div>
</div>

<style>
  .product-specifications {
    margin-top: 28px;
  }

  .product-specifications__row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 18px;
    font-size: 17px;
    line-height: 1.5;
  }

  .product-specifications__row strong {
    font-weight: 700;
  }

  .product-specifications__availability {
    color: #16803c;
    font-weight: 600;
  }

  .product-specifications__sizes {
    margin-top: 30px;
  }

  .product-specifications__sizes-title {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-specifications__size-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .product-specifications__size {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border: 1px solid #9ca3af;
    border-radius: 4px;
    background: #ffffff;
    color: #111827;
    font-size: 15px;
    font-weight: 600;
  }

  .product-specifications__quote {
    margin-top: 24px;
  }

  .product-specifications__quote-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 6px;
    background: #1477b9;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .product-specifications__quote-button:hover,
  .product-specifications__quote-button:focus-visible {
    outline: 3px solid rgba(20, 119, 185, 0.25);
    outline-offset: 3px;
    background: #10466e;
    transform: translateY(-1px);
  }
</style>
