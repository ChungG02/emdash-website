---
import type { PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";
import { getUiLocale, useTranslations } from "../../../i18n/ui";

interface Props {
	description?: PortableTextBlock[];
}

const { description = [] } = Astro.props;
const t = useTranslations(getUiLocale(Astro.cookies));
---

{
	description.length > 0 && (
		<section
			class="product-description"
			aria-label={t("products.description")}
		>
			<PortableText value={description} />
		</section>
	)
}

<style>
	.product-description {
		max-width: 1200px;
		margin-top: 56px;
		padding-top: 40px;
		border-top: 1px solid #e5e7eb;
		color: #111827;
	}

	.product-description :global(h2) {
		margin: 36px 0 14px;
		color: #1477b9;
		font-size: 28px;
		font-weight: 700;
		line-height: 1.3;
	}

	.product-description :global(h2:first-child) {
		margin-top: 0;
	}

	.product-description :global(h3) {
		margin: 28px 0 12px;
		font-size: 21px;
		line-height: 1.4;
	}

	.product-description :global(p) {
		margin: 0 0 20px;
		font-size: 18px;
		line-height: 1.7;
	}

	.product-description :global(strong) {
		font-weight: 700;
	}

	.product-description :global(ul),
	.product-description :global(ol) {
		margin: 0 0 24px;
		padding-left: 28px;
		font-size: 18px;
		line-height: 1.7;
	}

	.product-description :global(li) {
		margin-bottom: 10px;
	}

	@media (max-width: 600px) {
		.product-description {
			margin-top: 40px;
			padding-top: 32px;
		}

		.product-description :global(h2) {
			font-size: 24px;
		}

		.product-description :global(p),
		.product-description :global(ul),
		.product-description :global(ol) {
			font-size: 16px;
		}
	}
</style>
