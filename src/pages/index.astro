---
import {
  getEmDashCollection,
  getSiteSettings,
  getTermsForEntries,
} from "emdash";

import type { Product as EmDashProduct } from "../../.emdash/types";

import Base from "../layouts/Base.astro";
import HeroCarousel from "../components/carousel/HeroCarousel.astro";
import ProductSection from "../components/home/ProductSection.astro";
import TrustStrip from "../components/home/TrustStrip.astro";
import CatalogueBanner from "../components/home/CatalogueBanner.astro";
import NewsSection from "../components/home/NewsSection.astro";

import type { ProductSectionData } from "../modules/types/product.type";

import { productCategoryNavigationOrder } from "../data/navigation";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [productResult, postResult, settings] = await Promise.all([
  getEmDashCollection<"products", EmDashProduct>("products", {
    status: "published",
    orderBy: {
      published_at: "desc",
    },
    limit: 50,
  }),

  getEmDashCollection("posts", {
    status: "published",
    orderBy: {
      published_at: "desc",
    },
    limit: 8,
  }),

  getSiteSettings(),
]);


Astro.cache.set(productResult.cacheHint);
Astro.cache.set(postResult.cacheHint);

if (productResult.error) {
  console.error("Không thể tải sản phẩm từ EmDash:", productResult.error);
}

if (postResult.error) {
  console.error("Không thể tải tin tức từ EmDash:", postResult.error);
}

const categoryTermsByProduct = await getTermsForEntries(
  "products",
  productResult.entries.map((product) => product.data.id),
  "product_category",
);

const sectionsBySlug = new Map<string, ProductSectionData>();

for (const entry of productResult.entries) {
  const categories = categoryTermsByProduct.get(entry.data.id) ?? [];

  for (const category of categories) {
    const existingSection = sectionsBySlug.get(category.slug);

    const section: ProductSectionData = existingSection ?? {
      id: category.slug,
      title: category.label,
      products: [],
    };

    section.products.push({
      name: entry.data.title,
      image: entry.data.featured_image,
      alt: entry.data.featured_image?.alt ?? entry.data.title,
      href: `/products/${entry.id}`,
    });

    sectionsBySlug.set(category.slug, section);
  }
}

const categoryOrder = new Map(
  productCategoryNavigationOrder.map((slug, index) => [slug, index]),
);

const displaySections = Array.from(sectionsBySlug.values())
  .sort((firstSection, secondSection) => {
    const firstIndex = categoryOrder.get(firstSection.id);
    const secondIndex = categoryOrder.get(secondSection.id);

    if (firstIndex === undefined && secondIndex === undefined) return 0;
    if (firstIndex === undefined) return 1;
    if (secondIndex === undefined) return -1;

    return firstIndex - secondIndex;
  })
  .map((section, index) => ({
    ...section,
    alternate: index % 2 === 1,
  }));

const cmsNews = postResult.entries.map((post) => ({
  title: post.data.title,
  description: post.data.excerpt,
  image: post.data.featured_image,
  alt: post.data.featured_image?.alt ?? post.data.title,
  href: `/posts/${post.id}`,
  date: post.data.publishedAt?.toLocaleDateString("vi-VN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }),
}));

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
---

<Base title={siteTitle} description={siteTagline}>
  <HeroCarousel />

  {
    displaySections
      .slice(0, 3)
      .map((section) => <ProductSection section={section} />)
  }

  <TrustStrip />

  {
    displaySections
      .slice(3)
      .map((section) => <ProductSection section={section} />)
  }

  <CatalogueBanner />

  <NewsSection items={cmsNews} />
</Base>
