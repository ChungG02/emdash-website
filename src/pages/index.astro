---
import { getEmDashCollection, getSiteSettings } from "emdash";
import type { Product as EmDashProduct } from "../../.emdash/types";
import Base from "../layouts/Base.astro";
import HeroCarousel from "../components/carousel/HeroCarousel.astro";
import ProductSection from "../components/home/ProductSection.astro";
import TrustStrip from "../components/home/TrustStrip.astro";
import CatalogueBanner from "../components/home/CatalogueBanner.astro";
import NewsSection from "../components/home/NewsSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import { newsItems } from "../data/news";
import { productSections } from "../data/products";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [productResult, postResult, settings] = await Promise.all([
  getEmDashCollection<"products", EmDashProduct>("products", {
    status: "published",
    orderBy: { published_at: "desc" },
    limit: 50,
  }),
  getEmDashCollection("posts", {
    status: "published",
    orderBy: { published_at: "desc" },
    where: { category: "tin-tuc" },
    limit: 3,
  }),
  getSiteSettings(),
]);

if (Astro.cache?.enabled) {
  Astro.cache.set(productResult.cacheHint);
  Astro.cache.set(postResult.cacheHint);
}

if (productResult.error) {
  console.error("Không thể tải sản phẩm từ EmDash:", productResult.error);
}
if (postResult.error) {
  console.error("Không thể tải tin tức từ EmDash:", postResult.error);
}

const taxonomyAliases: Record<string, string[]> = {
  "bang-dinh": ["bang-dinh"],
  "hat-nhua-nguyen-sinh": ["hat-nhua-nguyen-sinh"],
  "mang-pe": ["mang-pe", "mang-quan-pe"],
  "thanh-nep-goc": ["thanh-nep-goc", "thanh-nep"],
  "san-pham-khac": ["san-pham-khac", "day-pet"],
};

const displaySections = productSections.map((fallbackSection) => {
  const aliases = taxonomyAliases[fallbackSection.id] ?? [fallbackSection.id];
  const matchingProducts = productResult.entries.filter((entry) => {
    const terms = entry.data.terms?.product_category ?? [];
    return terms.some((term) => aliases.includes(term.slug));
  });

  if (matchingProducts.length === 0) return fallbackSection;

  return {
    ...fallbackSection,
    products: matchingProducts.map((entry, index) => {
      const fallback = fallbackSection.products[index % fallbackSection.products.length];
      return {
        name: entry.data.title,
        image: entry.data.featured_image ?? fallback.image,
        alt: entry.data.featured_image?.alt ?? entry.data.title,
        fallbackImage: fallback.fallbackImage,
        objectPosition: fallback.objectPosition,
        href: `/products/${entry.id}`,
      };
    }),
  };
});

const cmsNews = postResult.entries.map((post, index) => {
  const fallback = newsItems[index % newsItems.length];
  return {
    title: post.data.title,
    description: post.data.excerpt ?? fallback.description,
    image: post.data.featured_image ?? fallback.image,
    fallbackImage: fallback.fallbackImage,
    alt: post.data.featured_image?.alt ?? post.data.title,
    href: `/posts/${post.id}`,
    date: post.data.publishedAt?.toLocaleDateString("vi-VN", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
    }),
  };
});

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
---

<Base title={siteTitle} description={siteTagline}>
  <HeroCarousel />

  {displaySections.slice(0, 3).map((section) => (
    <ProductSection section={section} />
  ))}

  <TrustStrip />

  {displaySections.slice(3).map((section) => (
    <ProductSection section={section} />
  ))}

  <CatalogueBanner />
  <NewsSection items={cmsNews.length > 0 ? cmsNews : newsItems} />
  <ContactSection />
</Base>
