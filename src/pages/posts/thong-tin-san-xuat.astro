---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Container from "../../components/common/Container.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import BaseLayout from "../../layouts/Base.astro";

const { entries: productionArticles, error, cacheHint } = await getEmDashCollection("posts", {
  status: "published",
  where: { category: "thong-tin-san-xuat" },
  orderBy: { published_at: "desc" },
  limit: 50,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
if (error) console.error("Không thể tải bài viết Thông tin sản xuất:", error);
---

<BaseLayout
  title="Thông tin sản xuất"
  description="Kiến thức về băng dính, băng keo và các giải pháp vật tư đóng gói công nghiệp của Thái Sơn Plastic."
>
  <Container>
    <article class="mx-auto max-w-5xl py-10 lg:py-14">
      <PageHeading eyebrow="Tin tức" title="Thông tin sản xuất" />

      {productionArticles.length > 0 ? (
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {productionArticles.map((article) => (
            <article class="news-card">
              {article.data.featured_image && (
                <a
                  href={`/posts/${article.id}`}
                  class="news-image"
                  aria-label={`Đọc bài viết: ${article.data.title}`}
                  {...article.edit.featured_image}
                >
                  <Image image={article.data.featured_image} />
                </a>
              )}

              <div class="news-body">
                <h3 {...article.edit.title}>
                  <a href={`/posts/${article.id}`}>{article.data.title}</a>
                </h3>
                {article.data.excerpt && <p {...article.edit.excerpt}>{article.data.excerpt}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded border border-slate-200 p-8 text-center text-slate-600">
          Chưa có bài viết Thông tin sản xuất nào được xuất bản.
        </div>
      )}
    </article>
  </Container>
</BaseLayout>
