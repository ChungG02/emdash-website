---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import type { Product } from "../../.emdash/types";

import Base from "../layouts/Base.astro";
import ProductCard from "../modules/products/components/ProductCard.astro";

const PAGE_SIZE = 12;
const COLLECTION_BATCH_SIZE = 100;
const MAX_BATCHES = 100;

type ProductEntry = {
  id: string;
  data: Product;
};

interface ProductSearchItem {
  slug: string;
  title: string;
  featuredImage?: Product["featured_image"];
}

const query = (Astro.url.searchParams.get("q")?.trim() ?? "").slice(0, 120);
const requestedPageValue = Number.parseInt(
  Astro.url.searchParams.get("page") ?? "1",
  10,
);
const requestedPage =
  Number.isFinite(requestedPageValue) && requestedPageValue > 0
    ? requestedPageValue
    : 1;

const normalizeSearchText = (value: string) =>
  value
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .replace(/đ/gi, "d")
    .toLocaleLowerCase("vi")
    .replace(/\s+/g, " ")
    .trim();

const getProductMatchScore = (
  entry: ProductEntry,
  normalizedQuery: string,
  queryTerms: string[],
) => {
  const normalizedTitle = normalizeSearchText(entry.data.title);

  if (normalizedTitle === normalizedQuery) return 0;
  if (normalizedTitle.startsWith(normalizedQuery)) return 1;
  if (normalizedTitle.includes(normalizedQuery)) return 2;
  if (queryTerms.every((term) => normalizedTitle.includes(term))) return 3;

  return null;
};

const toSearchItem = (entry: ProductEntry): ProductSearchItem => ({
  slug: entry.id,
  title: entry.data.title,
  featuredImage: entry.data.featured_image,
});

let products: ProductSearchItem[] = [];
let totalResults = 0;
let totalPages = 0;
let currentPage = requestedPage;
let hasSearchError = false;

if (query) {
  const allProducts: ProductEntry[] = [];
  let collectionCursor: string | undefined;

  for (let batch = 0; batch < MAX_BATCHES; batch += 1) {
    const result = await getEmDashCollection<"products", Product>("products", {
      status: "published",
      orderBy: { published_at: "desc" },
      limit: COLLECTION_BATCH_SIZE,
      cursor: collectionCursor,
    });

    Astro.cache.set(result.cacheHint);

    if (result.error) {
      hasSearchError = true;
      console.error("Không thể tải sản phẩm để tìm kiếm:", result.error);
      break;
    }

    allProducts.push(...result.entries);
    collectionCursor = result.nextCursor;

    if (!collectionCursor) break;
  }

  if (!hasSearchError) {
    const normalizedQuery = normalizeSearchText(query);
    const queryTerms = normalizedQuery.split(" ").filter(Boolean);

    const matchingProducts = allProducts
      .map((entry) => ({
        entry,
        score: getProductMatchScore(entry, normalizedQuery, queryTerms),
      }))
      .filter(
        (
          match,
        ): match is {
          entry: ProductEntry;
          score: number;
        } => match.score !== null,
      )
      .sort(
        (a, b) =>
          a.score - b.score ||
          a.entry.data.title.localeCompare(b.entry.data.title, "vi"),
      );

    totalResults = matchingProducts.length;
    totalPages = Math.ceil(totalResults / PAGE_SIZE);
    currentPage = totalPages > 0 ? Math.min(requestedPage, totalPages) : 1;
    products = matchingProducts
      .slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE)
      .map(({ entry }) => toSearchItem(entry));
  }
}

const createPageUrl = (page: number) => {
  const params = new URLSearchParams({ q: query });

  if (page > 1) params.set("page", String(page));

  return `/search?${params}`;
};

const previousPageUrl = currentPage > 1 ? createPageUrl(currentPage - 1) : null;
const nextPageUrl =
  currentPage < totalPages ? createPageUrl(currentPage + 1) : null;
---

<Base
  title={query ? `Tìm kiếm: ${query}` : "Tìm kiếm sản phẩm"}
  description="Kết quả tìm kiếm sản phẩm và giải pháp đóng gói công nghiệp"
>
  <section class="product-search-page" aria-labelledby="product-search-title">
    <header class="product-search-page__header">
      <p class="product-search-page__eyebrow">
        {query ? "Kết quả tìm kiếm" : "Danh mục sản phẩm"}
      </p>
      <h1 id="product-search-title">
        {query ? `Sản phẩm cho “${query}”` : "Tìm kiếm sản phẩm"}
      </h1>
      {
        query && !hasSearchError && (
          <p aria-live="polite">
            Tìm thấy <strong>{totalResults}</strong> sản phẩm phù hợp
            {totalPages > 1 && ` · Trang ${currentPage}/${totalPages}`}
          </p>
        )
      }
    </header>

    {
      !query ? (
        <div class="product-search-state">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <h2>Bạn đang tìm sản phẩm nào?</h2>
          <p>Nhập từ khóa vào ô tìm kiếm trên thanh đầu trang.</p>
          <a href="/products">Xem tất cả sản phẩm</a>
        </div>
      ) : hasSearchError ? (
        <div class="product-search-state product-search-state--error" role="alert">
          <h2>Chưa thể thực hiện tìm kiếm</h2>
          <p>Vui lòng thử lại sau ít phút hoặc liên hệ với chúng tôi để được hỗ trợ.</p>
        </div>
      ) : products.length === 0 ? (
        <div class="product-search-state" aria-live="polite">
          <h2>Không tìm thấy sản phẩm phù hợp</h2>
          <p>
            Không có kết quả cho “<strong>{query}</strong>”. Hãy thử một từ khóa
            khác trong ô tìm kiếm phía trên.
          </p>
          <a href="/products">Xem tất cả sản phẩm</a>
        </div>
      ) : (
        <div class="product-search-results">
          <ol class="product-search-grid">
            {products.map((product) => (
              <li>
                <ProductCard
                  title={product.title}
                  href={`/products/${product.slug}`}
                  featuredImage={product.featuredImage}
                />
              </li>
            ))}
          </ol>

          {totalPages > 1 && (
            <nav class="product-search-pagination" aria-label="Phân trang kết quả tìm kiếm">
              {previousPageUrl ? (
                <a href={previousPageUrl} rel="prev">
                  <span aria-hidden="true">←</span>
                  Trang trước
                </a>
              ) : (
                <span class="product-search-pagination__disabled" aria-disabled="true">
                  <span aria-hidden="true">←</span>
                  Trang trước
                </span>
              )}

              <span class="product-search-pagination__current">
                Trang {currentPage} / {totalPages}
              </span>

              {nextPageUrl ? (
                <a href={nextPageUrl} rel="next">
                  Trang sau
                  <span aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="product-search-pagination__disabled" aria-disabled="true">
                  Trang sau
                  <span aria-hidden="true">→</span>
                </span>
              )}
            </nav>
          )}
        </div>
      )
    }
  </section>
</Base>

<style>
  .product-search-page {
    width: min(1200px, calc(100% - 32px));
    min-height: 520px;
    margin: 0 auto;
    padding: 48px 0 72px;
  }

  .product-search-page__header {
    padding-bottom: 20px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .product-search-page__eyebrow {
    margin-bottom: 6px;
    color: var(--color-brand);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-search-page__header h1 {
    margin: 0 0 10px;
    color: var(--navy);
    font-size: clamp(30px, 5vw, 42px);
    line-height: 1.2;
  }

  .product-search-page__header > p:last-child {
    color: var(--color-text-secondary);
  }

  .product-search-state {
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 44px 24px;
    flex-direction: column;
    border: 1px dashed var(--color-border);
    border-radius: 12px;
    text-align: center;
    background: var(--color-bg-subtle);
  }

  .product-search-state svg {
    width: 52px;
    height: 52px;
    margin-bottom: 18px;
    color: var(--color-brand);
  }

  .product-search-state h2 {
    margin: 0 0 8px;
    color: var(--navy);
    font-size: 23px;
  }

  .product-search-state p {
    max-width: 620px;
    color: var(--color-text-secondary);
  }

  .product-search-state a {
    margin-top: 20px;
    color: var(--color-brand);
    font-weight: 700;
  }

  .product-search-state a:hover {
    text-decoration: underline;
  }

  .product-search-state--error {
    border-style: solid;
  }

  .product-search-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 292px));
    gap: 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .product-search-grid > li {
    min-width: 0;
  }

  .product-search-pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 18px;
    align-items: center;
    padding-top: 28px;
    margin-top: 36px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .product-search-pagination a,
  .product-search-pagination__disabled {
    width: fit-content;
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 15px;
    border: 1px solid var(--color-brand);
    border-radius: 6px;
    color: var(--color-brand);
    font-size: 14px;
    font-weight: 700;
  }

  .product-search-pagination a:last-child,
  .product-search-pagination__disabled:last-child {
    justify-self: end;
  }

  .product-search-pagination a:hover,
  .product-search-pagination a:focus-visible {
    outline: 0;
    color: #fff;
    background: var(--color-brand);
  }

  .product-search-pagination__disabled {
    border-color: var(--color-border);
    color: var(--color-muted);
    opacity: 0.55;
  }

  .product-search-pagination__current {
    color: var(--color-text-secondary);
    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }

  @media (max-width: 1050px) {
    .product-search-grid {
      grid-template-columns: repeat(3, minmax(0, 292px));
    }
  }

  @media (max-width: 780px) {
    .product-search-grid {
      grid-template-columns: repeat(2, minmax(0, 292px));
    }
  }

  @media (max-width: 560px) {
    .product-search-page {
      width: min(100% - 24px, 1200px);
      padding: 32px 0 52px;
    }

    .product-search-grid {
      grid-template-columns: minmax(0, 292px);
      justify-content: center;
    }

    .product-search-pagination {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .product-search-pagination__current {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .product-search-pagination a,
    .product-search-pagination__disabled {
      width: 100%;
      justify-content: center;
      padding-inline: 10px;
    }
  }
</style>
